{
  "default": {
    "paths": ["src/resources/features/**/*.feature"],
    "import": [
      "src/hooks/hooks.ts",
      "src/stepdefinitions/**/*.ts"
    ],
    "loader": ["ts-node/esm"],
    "format": [
      "@serenity-js/cucumber"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "publishQuiet": true
  }
}